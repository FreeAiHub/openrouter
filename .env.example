# ============================================
# OpenRouter + Manus AI Configuration
# Copy this file to .env and fill in your credentials
# ============================================

# --------------------------------------------
# OpenRouter API Configuration
# --------------------------------------------
# API Authentication
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxx

# Model Configuration
DEFAULT_MODEL=xiaomi/mimo-v2-flash:free
FALLBACK_MODEL=kwaipilot/kat-coder-pro-v1:free

# Rate Limiting
MAX_RETRIES=3
RETRY_DELAY=2
REQUEST_TIMEOUT=30

# Cost Controls
MAX_TOKENS_PER_REQUEST=2000
ENABLE_COST_TRACKING=true

# --------------------------------------------
# Manus AI Configuration
# --------------------------------------------
# Manus API Authentication
MANUS_API_KEY=sk-manus-xxxxxxxxxxxxx
MANUS_BASE_URL=https://api.manus.ai/v1

# Manus Webhook Configuration
MANUS_WEBHOOK_SECRET=your-webhook-secret-here

# Manus Task Settings
MANUS_DEFAULT_TIMEOUT=300
MANUS_POLL_INTERVAL=5
MANUS_MAX_RETRIES=3

# --------------------------------------------
# GitHub Integration
# --------------------------------------------
# GitHub Personal Access Token (for webhooks and API access)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxx

# GitHub Webhook Configuration
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# GitHub Repository
GITHUB_REPO=FreeAiHub/openrouter
GITHUB_OWNER=FreeAiHub

# --------------------------------------------
# Application Settings
# --------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# Monitoring
ENABLE_PROMETHEUS=false
ENABLE_STRUCTURED_LOGGING=true
ENABLE_METRICS=true
METRICS_PORT=9090

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# SQLite Database for task history
DB_PATH=./manus_tasks.db
DB_ECHO=false

# Database Connection Pool (if using PostgreSQL in production)
# DB_URL=postgresql://user:password@localhost:5432/manus_tasks
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# --------------------------------------------
# Web Dashboard Configuration
# --------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=true

# --------------------------------------------
# Webhook Server Configuration
# --------------------------------------------
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000

# --------------------------------------------
# Security Settings
# --------------------------------------------
# Secret key for Flask sessions
SECRET_KEY=your-secret-key-here-change-in-production

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# --------------------------------------------
# Logging Configuration
# --------------------------------------------
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# --------------------------------------------
# Cache Configuration
# --------------------------------------------
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300
MANUS_CACHE_DIR=.manus_cache
