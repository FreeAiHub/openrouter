# =============================================================================
# REQUIRED FOR BASIC USE
# These variables are needed to run Manus + OpenRouter integration and tests.
# =============================================================================

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
MANUS_API_KEY=sk-manus-xxxxxxxx
MANUS_BASE_URL=https://api.manus.ai/v1

# =============================================================================
# OPTIONAL: OpenRouter Configuration (Phase 1)
# =============================================================================
# API_BASE_URL=https://openrouter.ai/api/v1
# ENVIRONMENT=development
# LOG_LEVEL=INFO
# DEFAULT_MODEL=xiaomi/mimo-v2-flash:free
# FALLBACK_MODEL=kwaipilot/kat-coder-pro-v1:free
# MAX_RETRIES=3
# RETRY_DELAY=2
# REQUEST_TIMEOUT=30
# MAX_TOKENS_PER_REQUEST=2000
# ENABLE_COST_TRACKING=true
# ENABLE_PROMETHEUS=false
# ENABLE_STRUCTURED_LOGGING=true
# HTTP_REFERER=https://github.com/enterprise-ai
# X_TITLE=Enterprise AI Platform

# =============================================================================
# OPTIONAL: Manus Task Settings (Phase 1)
# =============================================================================
# MANUS_DEFAULT_TIMEOUT=300
# MANUS_POLL_INTERVAL=5
# MANUS_MAX_RETRIES=3
# MANUS_WEBHOOK_SECRET=your-webhook-secret-here

# =============================================================================
# OPTIONAL: GitHub integration / webhooks (Phase 2)
# Enable only if you plan to use GitHub automation.
# =============================================================================
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_REPO_OWNER=
# GITHUB_REPO_NAME=

# =============================================================================
# OPTIONAL: Dashboard / Monitoring / Database (Phase 2)
# Used for real-time monitoring UI and persistent task storage.
# =============================================================================
# DATABASE_URL=postgresql://user:pass@localhost:5432/openrouter
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_PORT=8000

# =============================================================================
# OPTIONAL: Webhook Server Configuration (Phase 2)
# =============================================================================
# WEBHOOK_HOST=0.0.0.0
# WEBHOOK_PORT=8000

# =============================================================================
# OPTIONAL: Security Settings (Phase 2)
# =============================================================================
# SECRET_KEY=your-secret-key-here-change-in-production
# CORS_ORIGINS=http://localhost:3000,http://localhost:5000
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# OPTIONAL: Logging Configuration (Phase 2)
# =============================================================================
# LOG_FILE=logs/app.log
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5

# =============================================================================
# OPTIONAL: Cache Configuration (Phase 2)
# =============================================================================
# CACHE_TYPE=simple
# CACHE_DEFAULT_TIMEOUT=300
# MANUS_CACHE_DIR=.manus_cache

# =============================================================================
# OPTIONAL: SQLite Database (Phase 2)
# =============================================================================
# DB_PATH=./manus_tasks.db
# DB_ECHO=false

# =============================================================================
# OPTIONAL: Prometheus Metrics (Phase 2)
# =============================================================================
# ENABLE_METRICS=true
# METRICS_PORT=9090
